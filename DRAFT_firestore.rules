rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Entity validation helper
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() <= 256
        && data.name is string && data.name.size() <= 100
        && data.role is string && (data.role == 'user' || data.role == 'doctor' || data.role == 'admin')
        && (data.age == '' || (data.age is number && data.age >= 0 && data.age <= 150))
        && (data.gender == '' || data.gender == 'Male' || data.gender == 'Female' || data.gender == 'Other')
        && (data.height == '' || (data.height is number && data.height >= 0 && data.height <= 300))
        && (data.weight == '' || (data.weight is number && data.weight >= 0 && data.weight <= 1000))
        && (data.bloodGroup == '' || data.bloodGroup == 'A+' || data.bloodGroup == 'A-' || data.bloodGroup == 'B+' || data.bloodGroup == 'B-' || data.bloodGroup == 'AB+' || data.bloodGroup == 'AB-' || data.bloodGroup == 'O+' || data.bloodGroup == 'O-')
        && (data.phoneNumber is string && data.phoneNumber.size() <= 20)
        && (data.address is string && data.address.size() <= 500)
        && (data.emergencyContact is string && data.emergencyContact.size() <= 100);
    }

    // Match rules for users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isSignedIn() 
        && isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().uid == userId
        && incoming().email == request.auth.token.email
        && (incoming().role == 'user' || incoming().role == 'doctor')
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn() 
        && isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().uid == userId
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: updateProfile
          (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'age', 'gender', 'height', 'weight', 'bloodGroup', 'phoneNumber', 'address', 'emergencyContact', 'updatedAt'])
           && incoming().role == existing().role)
        );

      allow delete: if isAdmin();
    }
  }
}
